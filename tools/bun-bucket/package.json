{
  "name": "bun-bucket",
  "version": "1.1.0",
  "description": "Zero-dependency native Bun S3 bucket uploader & downloader (CLI + TUI) with Bun Shell ($), S3Client multipart & list, Worker SHA-256 verification, proxy, and TLS support.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "bun-bucket": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "tui": "bun run src/index.ts --tui",
    "test": "bun test --check",
    "typecheck": "bun check",
    "build:linux-x64": "bun build --compile --check --target=bun-linux-x64 ./src/index.ts ./src/workers/hash-worker.ts ./src/isolated-entry.ts --outfile ./dist/bun-bucket-linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
