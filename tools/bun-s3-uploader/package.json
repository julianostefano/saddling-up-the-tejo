{
  "name": "bun-s3-uploader",
  "version": "1.0.0",
  "description": "Native Bun S3 uploader CLI & TUI with multipart upload, proxy, invalid-TLS support, SHA-256 verification, ETA, speed, and bandwidth metrics",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "bun-s3-upload": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "tui": "bun run src/index.ts --tui",
    "test": "bun test --check",
    "typecheck": "bun check",
    "build:linux-x64": "bun build --compile --check --target=bun-linux-x64 ./src/index.ts ./src/workers/hash-worker.ts ./src/isolated-entry.ts --outfile ./dist/bun-s3-upload-linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
